        "class": "StateMachine",
        "calls": [
            {
                "add_state": {
                    "name": "black",
                    "on_enter": [
                        "lambda: $leds.strip1.set_pattern($patterns.black0, zone=0)",
                        "lambda: $leds.strip1.set_pattern($patterns.black1, zone=1)",
